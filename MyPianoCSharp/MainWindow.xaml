<Window
    x:Class="MyPiano.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MyPiano">

    <Grid x:Name="Root" Padding="16" RowSpacing="12" Background="#202020" IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- Wide: controls on the left, drum pads on the right -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow: drum pads move under the controls -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DrumPanel.(Grid.Column)" Value="0" />
                        <Setter Target="DrumPanel.(Grid.Row)" Value="1" />
                        <Setter Target="DrumPanel.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Control panel -->
        <Grid Grid.Row="0" ColumnSpacing="24" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="10">
                <!-- Instrument + banks -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Instrument" VerticalAlignment="Center" Foreground="#C0C0C0" />
                    <Button x:Name="BtnInstrument" Grid.Column="1" HorizontalAlignment="Stretch" Content="Piano" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                ToolTipService.ToolTip="Banks: F1-F4. Right-click to assign an instrument.">
                        <Button x:Name="BtnBank0" Content="1" Tag="0" Width="40" />
                        <Button x:Name="BtnBank1" Content="2" Tag="1" Width="40" />
                        <Button x:Name="BtnBank2" Content="3" Tag="2" Width="40" />
                        <Button x:Name="BtnBank3" Content="4" Tag="3" Width="40" />
                    </StackPanel>
                </Grid>

                <!-- Beat -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Beat" VerticalAlignment="Center" Foreground="#C0C0C0" />
                    <Button x:Name="BtnBeat" Grid.Column="1" HorizontalAlignment="Stretch" Content="Disco" />
                </Grid>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnIntro" Grid.Column="0" HorizontalAlignment="Stretch" Content="Intro (F5)" Tag="0" />
                    <Button x:Name="BtnFill1" Grid.Column="1" HorizontalAlignment="Stretch" Content="Fill 1 (F6)" Tag="1" />
                    <Button x:Name="BtnFill2" Grid.Column="2" HorizontalAlignment="Stretch" Content="Fill 2 (F7)" Tag="2" />
                    <Button x:Name="BtnEnd" Grid.Column="3" HorizontalAlignment="Stretch" Content="End (F8)" Tag="3" />
                    <Button x:Name="BtnStop" Grid.Column="4" HorizontalAlignment="Stretch" Content="Stop (F9)" Tag="4" />
                </Grid>

                <!-- Sliders -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tempo" VerticalAlignment="Center" Foreground="#C0C0C0" />
                    <Slider x:Name="SldTempo" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                            ToolTipService.ToolTip="Right = slower" />
                    <TextBlock Grid.Column="2" Text="Volume" VerticalAlignment="Center" Foreground="#C0C0C0" Margin="12,0,0,0" />
                    <Slider x:Name="SldVolume" Grid.Column="3" Minimum="0" Maximum="127" Value="127" />
                </Grid>

                <!-- Effects -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Reverb" VerticalAlignment="Center" Foreground="#C0C0C0" />
                    <Slider x:Name="SldReverb" Grid.Column="1" Minimum="0" Maximum="127" Value="40" />
                    <TextBlock Grid.Column="2" Text="Chorus" VerticalAlignment="Center" Foreground="#C0C0C0" Margin="12,0,0,0" />
                    <Slider x:Name="SldChorus" Grid.Column="3" Minimum="0" Maximum="127" Value="0" />
                </Grid>

                <!-- Synth-only effects -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Delay" VerticalAlignment="Center" Foreground="#C0C0C0" />
                    <Slider x:Name="SldDelay" Grid.Column="1" Minimum="0" Maximum="127" Value="0"
                            ToolTipService.ToolTip="Echo (SoundFont output only)" />
                    <TextBlock Grid.Column="2" Text="Drive" VerticalAlignment="Center" Foreground="#C0C0C0" Margin="12,0,0,0" />
                    <Slider x:Name="SldDrive" Grid.Column="3" Minimum="0" Maximum="127" Value="0"
                            ToolTipService.ToolTip="Distortion (SoundFont output only)" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tremolo" VerticalAlignment="Center" Foreground="#C0C0C0" />
                    <Slider x:Name="SldTremolo" Grid.Column="1" Minimum="0" Maximum="127" Value="0"
                            ToolTipService.ToolTip="Volume wobble (SoundFont output only)" />
                    <TextBlock Grid.Column="2" Text="Tone" VerticalAlignment="Center" Foreground="#C0C0C0" Margin="12,0,0,0" />
                    <Slider x:Name="SldTone" Grid.Column="3" Minimum="0" Maximum="127" Value="64"
                            ToolTipService.ToolTip="Left = bass, right = treble (SoundFont output only)" />
                </Grid>

                <!-- Key + device -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Key" VerticalAlignment="Center" Foreground="#C0C0C0" />
                    <Button x:Name="BtnKey" Grid.Column="1" Content="C" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="2" Text="Device" VerticalAlignment="Center" Foreground="#C0C0C0" Margin="12,0,0,0" />
                    <Button x:Name="BtnDevice" Grid.Column="3" HorizontalAlignment="Stretch" Content="(none)" />
                </Grid>
            </StackPanel>

            <!-- Drum pads (numpad layout) -->
            <StackPanel x:Name="DrumPanel" Grid.Column="1" Grid.Row="0" Spacing="4">
                <TextBlock Text="Drum pads (numpad, click to change sound)" Foreground="#808080" />
                <Grid x:Name="DrumGrid" RowSpacing="4" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Piano: keys are laid out in code to fill this area -->
        <Grid x:Name="PianoHost" Grid.Row="1" MinHeight="120">
            <Canvas x:Name="PianoCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Window>
