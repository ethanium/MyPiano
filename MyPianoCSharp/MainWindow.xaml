<Window
    x:Class="MyPiano.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MyPiano">

    <Grid x:Name="Root" Padding="16" RowSpacing="12" Background="#202020" IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Control panel -->
        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="10">
                <!-- Instrument + banks -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Instrument" VerticalAlignment="Center" Width="70" Foreground="#C0C0C0" />
                    <Button x:Name="BtnInstrument" MinWidth="220" Content="Piano" />
                    <TextBlock Text="Banks (F1-F4, right-click to assign)" VerticalAlignment="Center" Foreground="#808080" Margin="12,0,0,0" />
                    <Button x:Name="BtnBank0" Content="1" Tag="0" Width="40" />
                    <Button x:Name="BtnBank1" Content="2" Tag="1" Width="40" />
                    <Button x:Name="BtnBank2" Content="3" Tag="2" Width="40" />
                    <Button x:Name="BtnBank3" Content="4" Tag="3" Width="40" />
                </StackPanel>

                <!-- Beat -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Beat" VerticalAlignment="Center" Width="70" Foreground="#C0C0C0" />
                    <Button x:Name="BtnBeat" MinWidth="220" Content="Disco" />
                    <Button x:Name="BtnIntro" Content="Intro (F5)" Tag="0" />
                    <Button x:Name="BtnFill1" Content="Fill 1 (F6)" Tag="1" />
                    <Button x:Name="BtnFill2" Content="Fill 2 (F7)" Tag="2" />
                    <Button x:Name="BtnEnd" Content="End (F8)" Tag="3" />
                    <Button x:Name="BtnStop" Content="Stop (F9)" Tag="4" />
                </StackPanel>

                <!-- Sliders -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Tempo" VerticalAlignment="Center" Width="70" Foreground="#C0C0C0" />
                    <Slider x:Name="SldTempo" Width="220" Minimum="0" Maximum="100" Value="0"
                            ToolTipService.ToolTip="Right = slower" />
                    <TextBlock Text="Volume" VerticalAlignment="Center" Foreground="#C0C0C0" Margin="12,0,0,0" />
                    <Slider x:Name="SldVolume" Width="220" Minimum="0" Maximum="127" Value="127" />
                </StackPanel>

                <!-- Key + device -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Key" VerticalAlignment="Center" Width="70" Foreground="#C0C0C0" />
                    <Button x:Name="BtnKey" Content="C" Width="60" />
                    <TextBlock Text="Device" VerticalAlignment="Center" Foreground="#C0C0C0" Margin="12,0,0,0" />
                    <Button x:Name="BtnDevice" MinWidth="320" Content="(none)" />
                </StackPanel>
            </StackPanel>

            <!-- Drum pads (numpad layout) -->
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Drum pads (numpad, click to change sound)" Foreground="#808080" />
                <Grid x:Name="DrumGrid" RowSpacing="4" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Piano -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Canvas x:Name="PianoCanvas" Height="200" HorizontalAlignment="Left" />
        </ScrollViewer>
    </Grid>
</Window>
