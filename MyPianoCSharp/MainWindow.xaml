<Window
    x:Class="MyPiano.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="My MIDI">

    <Grid x:Name="Root" Padding="20" RowSpacing="16" Background="#0E0E10" IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
        </Grid.RowDefinitions>

        <!-- Header: title + output device -->
        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <Border Width="6" Height="36" CornerRadius="3" Background="#FFB300" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="My MIDI" FontSize="22" FontWeight="Bold" Foreground="#F2F2F5" />
                    <TextBlock Text="MIDI CONTROLLER" FontSize="10" Foreground="#6E6E78" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="BtnDevice" Grid.Column="2"
                    Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                    CornerRadius="6" Padding="10,6" FontSize="13"
                    Content="(none)" MinWidth="220" VerticalAlignment="Center" />
        </Grid>

        <!-- Control surface + drum pads -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1E" BorderBrush="#2B2B32" BorderThickness="1"
                    CornerRadius="12" Padding="16">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column: sound / rhythm / tempo -->
                    <StackPanel Grid.Column="0" Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SOUND" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E78" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnInstrument" Grid.Column="0"
                                        Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13"
                                        Content="Piano" HorizontalAlignment="Stretch" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="BtnBank0" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="1" Width="40" ToolTipService.ToolTip="F1" />
                                    <Button x:Name="BtnBank1" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="2" Width="40" ToolTipService.ToolTip="F2" />
                                    <Button x:Name="BtnBank2" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="3" Width="40" ToolTipService.ToolTip="F3" />
                                    <Button x:Name="BtnBank3" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="4" Width="40" ToolTipService.ToolTip="F4" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="RHYTHM" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E78" />
                            <Button x:Name="BtnBeat" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" FontSize="13" Content="Disco" HorizontalAlignment="Stretch" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnIntro" Grid.Column="0" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="Intro" HorizontalAlignment="Stretch" Tag="0" ToolTipService.ToolTip="F5" />
                                <Button x:Name="BtnFill1" Grid.Column="1" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="Fill 1" HorizontalAlignment="Stretch" Tag="1" ToolTipService.ToolTip="F6" />
                                <Button x:Name="BtnFill2" Grid.Column="2" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="Fill 2" HorizontalAlignment="Stretch" Tag="2" ToolTipService.ToolTip="F7" />
                                <Button x:Name="BtnEnd" Grid.Column="3" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="End" HorizontalAlignment="Stretch" Tag="3" ToolTipService.ToolTip="F8" />
                                <Button x:Name="BtnStop" Grid.Column="4" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="Stop" HorizontalAlignment="Stretch" Tag="4" ToolTipService.ToolTip="F9" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="TEMPO" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E78" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SldTempo" Grid.Column="0" Minimum="0" Maximum="100" Value="0"
                                        ToolTipService.ToolTip="Right = slower" />
                                <TextBlock x:Name="TxtTempo" Grid.Column="1" Text="0" FontSize="12" Foreground="#FFB300"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="30" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right column: effects / master / setup -->
                    <StackPanel Grid.Column="1" Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="EFFECTS" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E78" />
                            <Grid ColumnSpacing="10" RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="80" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Reverb" FontSize="13" Foreground="#B8B8C0" VerticalAlignment="Center" />
                                <Slider x:Name="SldReverb" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="127" Value="40" />
                                <TextBlock x:Name="TxtReverb" Grid.Row="0" Grid.Column="2" Text="40" FontSize="12" Foreground="#FFB300"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="30" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Chorus" FontSize="13" Foreground="#B8B8C0" VerticalAlignment="Center" />
                                <Slider x:Name="SldChorus" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="127" Value="0" />
                                <TextBlock x:Name="TxtChorus" Grid.Row="1" Grid.Column="2" Text="0" FontSize="12" Foreground="#FFB300"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="30" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Delay" FontSize="13" Foreground="#B8B8C0" VerticalAlignment="Center" />
                                <Slider x:Name="SldDelay" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="127" Value="0"
                                        ToolTipService.ToolTip="Echo (SoundFont output only)" />
                                <TextBlock x:Name="TxtDelay" Grid.Row="2" Grid.Column="2" Text="0" FontSize="12" Foreground="#FFB300"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="30" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Drive" FontSize="13" Foreground="#B8B8C0" VerticalAlignment="Center" />
                                <Slider x:Name="SldDrive" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="127" Value="0"
                                        ToolTipService.ToolTip="Distortion (SoundFont output only)" />
                                <TextBlock x:Name="TxtDrive" Grid.Row="3" Grid.Column="2" Text="0" FontSize="12" Foreground="#FFB300"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="30" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tremolo" FontSize="13" Foreground="#B8B8C0" VerticalAlignment="Center" />
                                <Slider x:Name="SldTremolo" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="127" Value="0"
                                        ToolTipService.ToolTip="Volume wobble (SoundFont output only)" />
                                <TextBlock x:Name="TxtTremolo" Grid.Row="4" Grid.Column="2" Text="0" FontSize="12" Foreground="#FFB300"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="30" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Tone" FontSize="13" Foreground="#B8B8C0" VerticalAlignment="Center" />
                                <Slider x:Name="SldTone" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="127" Value="64"
                                        ToolTipService.ToolTip="Left = bass, right = treble (SoundFont output only)" />
                                <TextBlock x:Name="TxtTone" Grid.Row="5" Grid.Column="2" Text="64" FontSize="12" Foreground="#FFB300"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="30" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="MASTER" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E78" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SldVolume" Grid.Column="0" Minimum="0" Maximum="127" Value="127" />
                                <TextBlock x:Name="TxtVolume" Grid.Column="1" Text="127" FontSize="12" Foreground="#FFB300"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" MinWidth="30" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="SETUP" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E78" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Key" Grid.Column="0" FontSize="13" Foreground="#B8B8C0" VerticalAlignment="Center" />
                                <Button x:Name="BtnKey" Grid.Column="1" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="C" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Oct" Grid.Column="2" FontSize="13" Foreground="#B8B8C0" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <Button x:Name="BtnOctDown" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="-" Width="40" />
                                    <TextBlock x:Name="TxtOct" Text="0" FontSize="12" Foreground="#FFB300" MinWidth="28"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                    <Button x:Name="BtnOctUp" Background="#26262C" Foreground="#E6E6EA" BorderBrush="#34343C" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="+" Width="40" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drum pads (MPC style, 3x4, stretch to fill) -->
            <Border x:Name="DrumPanel" Grid.Column="1" Background="#1A1A1E" BorderBrush="#2B2B32" BorderThickness="1"
                    CornerRadius="12" Padding="14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="DRUM PADS" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E78"
                               ToolTipService.ToolTip="Click a pad to play. Right-click to change its sound." />
                    <Grid x:Name="DrumGrid" Grid.Row="1" RowSpacing="6" ColumnSpacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Piano keybed -->
        <Border Grid.Row="2" Background="#1A1A1E" BorderBrush="#2B2B32" BorderThickness="1" CornerRadius="12" Padding="10">
            <Grid x:Name="PianoHost" MinHeight="150">
                <Canvas x:Name="PianoCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>