<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyPiano.MainWindow"
        Title="My MIDI"
        Width="1120" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBg}">

    <Grid x:Name="Root" Margin="20" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
        </Grid.RowDefinitions>

        <!-- Header: title + theme + output device -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <Border Width="6" Height="36" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="My MIDI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TitleText}" />
                    <TextBlock Text="MIDI CONTROLLER" FontSize="10" Foreground="{DynamicResource DimText}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnTheme" Width="36" Height="32" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}"
                        BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                        CornerRadius="6" />
                <DropDownButton x:Name="BtnDevice"
                                Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" FontSize="13"
                                Content="(none)" MinWidth="220" />
            </StackPanel>
        </Grid>

        <!-- Control surface + drum pads -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,16,0"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column: sound / rhythm / tempo -->
                    <StackPanel Grid.Column="0" Margin="0,0,11,0" Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SOUND" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DropDownButton x:Name="BtnInstrument" Grid.Column="0" Margin="0,0,8,0"
                                                Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}"
                                                BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                                CornerRadius="6" Padding="10,6" FontSize="13"
                                                Content="Piano" HorizontalAlignment="Stretch" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="BtnBank0" Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="1" Width="40"
                                            ToolTip.Tip="F1" />
                                    <Button x:Name="BtnBank1" Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="2" Width="40"
                                            ToolTip.Tip="F2" />
                                    <Button x:Name="BtnBank2" Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="3" Width="40"
                                            ToolTip.Tip="F3" />
                                    <Button x:Name="BtnBank3" Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="4" Width="40"
                                            ToolTip.Tip="F4" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="RHYTHM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimText}" />
                            <DropDownButton x:Name="BtnBeat"
                                            Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}"
                                            BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13"
                                            Content="Disco" HorizontalAlignment="Stretch" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnIntro" Grid.Column="0" Margin="0,6,3,0" Tag="0"
                                        Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="Intro" HorizontalAlignment="Stretch"
                                        ToolTip.Tip="F5" />
                                <Button x:Name="BtnFill1" Grid.Column="1" Margin="3,6,3,0" Tag="1"
                                        Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="Fill 1" HorizontalAlignment="Stretch"
                                        ToolTip.Tip="F6" />
                                <Button x:Name="BtnFill2" Grid.Column="2" Margin="3,6,3,0" Tag="2"
                                        Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="Fill 2" HorizontalAlignment="Stretch"
                                        ToolTip.Tip="F7" />
                                <Button x:Name="BtnEnd" Grid.Column="3" Margin="3,6,3,0" Tag="3"
                                        Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="End" HorizontalAlignment="Stretch"
                                        ToolTip.Tip="F8" />
                                <Button x:Name="BtnStop" Grid.Column="4" Margin="3,6,0,0" Tag="4"
                                        Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" FontSize="13" Content="Stop" HorizontalAlignment="Stretch"
                                        ToolTip.Tip="F9" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="TEMPO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SldTempo" Grid.Column="0" Minimum="0" Maximum="100" Value="0"
                                        ToolTip.Tip="Right = slower" />
                                <TextBlock x:Name="TxtTempo" Grid.Column="1" Text="0" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right column: effects / master / setup -->
                    <StackPanel Grid.Column="1" Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="EFFECTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="80" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Reverb" FontSize="13" Foreground="{DynamicResource SoftText}" VerticalAlignment="Center" />
                                <Slider x:Name="SldReverb" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="127" Value="40" />
                                <TextBlock x:Name="TxtReverb" Grid.Row="0" Grid.Column="2" Text="40" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Chorus" FontSize="13" Foreground="{DynamicResource SoftText}" VerticalAlignment="Center" />
                                <Slider x:Name="SldChorus" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="127" Value="0" />
                                <TextBlock x:Name="TxtChorus" Grid.Row="1" Grid.Column="2" Text="0" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Delay" FontSize="13" Foreground="{DynamicResource SoftText}" VerticalAlignment="Center" />
                                <Slider x:Name="SldDelay" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="127" Value="0"
                                        ToolTip.Tip="Echo (SoundFont output only)" />
                                <TextBlock x:Name="TxtDelay" Grid.Row="2" Grid.Column="2" Text="0" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Drive" FontSize="13" Foreground="{DynamicResource SoftText}" VerticalAlignment="Center" />
                                <Slider x:Name="SldDrive" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="127" Value="0"
                                        ToolTip.Tip="Distortion (SoundFont output only)" />
                                <TextBlock x:Name="TxtDrive" Grid.Row="3" Grid.Column="2" Text="0" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tremolo" FontSize="13" Foreground="{DynamicResource SoftText}" VerticalAlignment="Center" />
                                <Slider x:Name="SldTremolo" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="127" Value="0"
                                        ToolTip.Tip="Volume wobble (SoundFont output only)" />
                                <TextBlock x:Name="TxtTremolo" Grid.Row="4" Grid.Column="2" Text="0" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Tone" FontSize="13" Foreground="{DynamicResource SoftText}" VerticalAlignment="Center" />
                                <Slider x:Name="SldTone" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="127" Value="64"
                                        ToolTip.Tip="Left = bass, right = treble (SoundFont output only)" />
                                <TextBlock x:Name="TxtTone" Grid.Row="5" Grid.Column="2" Text="64" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="MASTER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SldVolume" Grid.Column="0" Minimum="0" Maximum="127" Value="127" />
                                <TextBlock x:Name="TxtVolume" Grid.Column="1" Text="127" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="SETUP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Key" Grid.Column="0" FontSize="13" Foreground="{DynamicResource SoftText}" VerticalAlignment="Center" />
                                <DropDownButton x:Name="BtnKey" Grid.Column="1" Margin="0,0,8,0"
                                                Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}"
                                                BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                                CornerRadius="6" Padding="10,6" FontSize="13"
                                                Content="C" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Oct" Grid.Column="2" Margin="4,0,4,0" FontSize="13" Foreground="{DynamicResource SoftText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <Button x:Name="BtnOctDown" Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="-" Width="40" />
                                    <TextBlock x:Name="TxtOct" Text="0" FontSize="12" Foreground="{DynamicResource AccentBrush}" MinWidth="28"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                                    <Button x:Name="BtnOctUp" Background="{DynamicResource CtrlBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CtrlBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" FontSize="13" Content="+" Width="40" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drum pads (MPC style, 3x4 UniformGrid of squares) -->
            <Border x:Name="DrumPanel" Grid.Column="1"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="DRUM PADS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimText}"
                               ToolTip.Tip="Click a pad to play. Right-click to change its sound." />
                    <UniformGrid x:Name="DrumGrid" Grid.Row="1" Rows="4" Columns="3"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Piano keybed -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
            <Grid x:Name="PianoHost" MinHeight="150">
                <Canvas x:Name="PianoCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>